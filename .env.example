# Copie para .env
# Opcional. Sem isto o front usa o mesmo host da página na porta 3333 (localhost ou o IP da rede),
# que é o que faz o cookie de login funcionar. Só defina se a API estiver em outro lugar,
# e nesse caso o host precisa ser o mesmo "site" do front.
# VITE_API_URL=http://localhost:3333

# Produção (Railway): o front serve a API em /api, na mesma origem (sem CORS e com o cookie de login).
#   VITE_API_URL=/api
#   API_INTERNAL_URL=http://<servico-da-api>.railway.internal:<porta>   (usado pelo proxy do `npm start`)
